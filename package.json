{
  "name": "yapizza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:reset": "prisma migrate reset --force",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "extract": "tsx --env-file=.env scripts/extract.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "grok:record": "tsx --env-file=.env scripts/grok-record.ts",
    "google:token": "tsx --env-file=.env scripts/google-token.ts",
    "test:smoke": "playwright test tests/smoke --pass-with-no-tests",
    "demo:reset": "pnpm db:reset && tsx --env-file=.env scripts/demo-reset.ts",
    "demo:check": "pnpm typecheck && pnpm test:smoke && tsx --env-file=.env scripts/demo-check.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "googleapis": "^190.0.0",
    "ics": "^3.12.1",
    "lucide-react": "^1.74.0",
    "mailparser": "^3.14.5",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "node-ical": "^0.27.6",
    "openai": "^7.58.0",
    "papaparse": "^5.7.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.7",
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
}
